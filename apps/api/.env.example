NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://procurex:procurex@localhost:5432/procurex?schema=public
REDIS_URL=redis://localhost:6379
# >= 32 ký tự, hai secret phải KHÁC nhau. Sinh nhanh (PowerShell):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
CORS_ORIGIN=http://localhost:3000
# Tin X-Forwarded-For từ proxy nào (BFF Next cùng máy = loopback)
TRUST_PROXY=loopback
# Giai đoạn 3 – job nền
WORKERS_ENABLED=true
OUTBOX_POLL_MS=1000
APPROVAL_SLA_HOURS=24
PUBLIC_APP_URL=http://localhost:3000
ERP_MOCK_FAILURE_RATE=0.3
