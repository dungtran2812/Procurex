// Prisma 6 (prisma-client-js). Tên model/field theo camelCase trong code,
// còn tên bảng/cột trong DB theo snake_case nhờ @map / @@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  APPROVER
  BUYER

  @@map("user_role")
}

enum CompanyTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM

  @@map("company_tier")
}

model Company {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  taxCode     String      @unique @map("tax_code")
  tier        CompanyTier @default(STANDARD)
  // Tiền: luôn dùng Decimal, KHÔNG dùng float (0.1 + 0.2 != 0.3).
  creditLimit Decimal     @default(0) @map("credit_limit") @db.Decimal(14, 2)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  users User[]

  @@map("companies")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  fullName      String   @map("full_name")
  role          Role     @default(BUYER)
  // Hạn mức phê duyệt (VND). Dùng ở Giai đoạn 3 (approval nhiều cấp).
  approvalLimit Decimal  @default(0) @map("approval_limit") @db.Decimal(14, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("users")
}

// ============================================================
//  Giai đoạn 1b – Catalog
// ============================================================

// Cây danh mục dùng ltree: path = 'dung_cu.dung_cu_cam_tay.co_le'.
// Prisma chưa hỗ trợ ltree nên khai báo Unsupported → chỉ đọc/ghi qua $queryRaw.
model Category {
  id        String                 @id @default(uuid()) @db.Uuid
  name      String
  slug      String                 @unique
  path      Unsupported("ltree")
  createdAt DateTime               @default(now()) @map("created_at")

  products Product[]

  @@index([path], type: Gist)
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique
  name        String
  categoryId  String   @map("category_id") @db.Uuid
  unit        String // "cái", "hộp", "mét"...
  // Thông số kỹ thuật linh hoạt theo từng loại: { "size_mm": 12, "material": "CrV" }
  specs       Json     @default("{}")
  minOrderQty Int      @default(1) @map("min_order_qty")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceTiers    PriceTier[]
  companyPrices CompanyPrice[]

  @@index([categoryId])
  @@index([specs], type: Gin)
  @@map("products")
}

// Giá niêm yết theo bậc số lượng: mua >= minQty thì đơn giá = unitPrice.
// VND không có phần lẻ → Decimal(14,0).
model PriceTier {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  minQty    Int     @map("min_qty")
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQty])
  @@map("price_tiers")
}

// Giá hợp đồng riêng cho 1 công ty, có hiệu lực theo thời gian (validTo = null → vô thời hạn).
model CompanyPrice {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  unitPrice Decimal   @map("unit_price") @db.Decimal(14, 0)
  validFrom DateTime  @map("valid_from")
  validTo   DateTime? @map("valid_to")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId])
  @@map("company_prices")
}

// ============================================================
//  Giai đoạn 2 – Procurement: Purchase Request + duyệt nhiều cấp
// ============================================================

enum PrStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED

  @@map("pr_status")
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_decision")
}

model PurchaseRequest {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  requesterId String    @map("requester_id") @db.Uuid
  title       String
  note        String?
  status      PrStatus  @default(DRAFT)
  totalAmount Decimal   @default(0) @map("total_amount") @db.Decimal(16, 0)
  // Optimistic locking: mỗi lần ghi phải khớp version đang đọc, rồi +1.
  version     Int       @default(0)
  submittedAt DateTime? @map("submitted_at")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lines PurchaseRequestLine[]
  steps ApprovalStep[]

  @@index([companyId, status, createdAt])
  @@index([companyId, requesterId])
  @@map("purchase_requests")
}

// Dòng hàng: SNAPSHOT giá + thông tin sản phẩm tại thời điểm tạo, không trỏ sang bảng giá.
model PurchaseRequestLine {
  id          String  @id @default(uuid()) @db.Uuid
  prId        String  @map("pr_id") @db.Uuid
  lineNo      Int     @map("line_no")
  productId   String  @map("product_id") @db.Uuid
  sku         String
  productName String  @map("product_name")
  unit        String
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 0)
  priceSource String  @map("price_source") // TIER | CONTRACT
  lineTotal   Decimal @map("line_total") @db.Decimal(16, 0)

  pr PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@unique([prId, lineNo])
  @@map("purchase_request_lines")
}

// Quy tắc duyệt CẤU HÌNH ĐƯỢC theo công ty: PR có tổng >= minTotal thì cần duyệt cấp `level`.
// Người duyệt cấp đó phải có approvalLimit >= minApproverLimit.
model ApprovalRule {
  id               String  @id @default(uuid()) @db.Uuid
  companyId        String  @map("company_id") @db.Uuid
  level            Int
  minTotal         Decimal @map("min_total") @db.Decimal(16, 0)
  minApproverLimit Decimal @map("min_approver_limit") @db.Decimal(16, 0)

  @@unique([companyId, level])
  @@map("approval_rules")
}

// Các bước duyệt sinh ra lúc submit (snapshot quy tắc lúc đó).
model ApprovalStep {
  id               String           @id @default(uuid()) @db.Uuid
  prId             String           @map("pr_id") @db.Uuid
  level            Int
  minApproverLimit Decimal          @map("min_approver_limit") @db.Decimal(16, 0)
  decision         ApprovalDecision @default(PENDING)
  decidedBy        String?          @map("decided_by") @db.Uuid
  comment          String?
  decidedAt        DateTime?        @map("decided_at")

  pr PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@unique([prId, level])
  @@map("approval_steps")
}

// Audit trail: CHỈ GHI THÊM (append-only).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  actorId    String   @map("actor_id") @db.Uuid
  data       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

// Transactional outbox: event ghi CÙNG transaction với thay đổi nghiệp vụ, relay đẩy đi sau.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
